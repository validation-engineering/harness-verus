{
  "name": "@validation-engineering/harness-verus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Official DeepSeek Harness workflows on cordis-verus, with composable JavaScript and Rust plugins",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "harness-verus": "bin/harness-verus.mjs"
  },
  "exports": {
    "./plugin-api": "./src/plugin-api.mjs",
    "./official-plugin-api": "./src/official-plugin-api.mjs",
    "./official-loader-api": {
      "types": "./src/official-loader-api.d.mts",
      "default": "./src/official-loader-api.mjs"
    },
    "./native-module-artifacts": "./src/native-module-artifacts.mjs"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-install.mjs",
    "start": "node --import @validation-engineering/cordis-compat-deepseek/register src/cli.mjs",
    "demo": "node --import @validation-engineering/cordis-compat-deepseek/register src/cli.mjs demo",
    "test": "node --import @validation-engineering/cordis-compat-deepseek/register --test --test-timeout=30000 tests/*.test.mjs",
    "pretest": "node scripts/verify-install.mjs",
    "predemo": "node scripts/verify-install.mjs",
    "prestart": "node scripts/verify-install.mjs",
    "official:install": "node scripts/install-official.mjs",
    "official:verify": "node scripts/verify-official.mjs",
    "official": "node scripts/official.mjs",
    "official:check": "node scripts/record-official-validation.mjs",
    "rust:build": "node scripts/build-rust-addon.mjs",
    "rust:verify": "node scripts/verify-rust-addon.mjs",
    "rust:test": "node --test tests/official/rust-addon.test.mjs",
    "official:extensions": "node scripts/official-extensions.mjs",
    "official:extensions:check": "node scripts/check-official-extensions.mjs --backend native --rust",
    "official:supervise": "node scripts/official-supervise.mjs",
    "official:watch": "node scripts/official-supervise.mjs --watch",
    "official:process:test": "node --test --test-timeout=120000 tests/official/process-supervisor.test.mjs",
    "rust:modules:build": "node scripts/build-rust-modules.mjs",
    "rust:modules:verify": "node scripts/verify-rust-modules.mjs",
    "rust:modules:demo": "node --import @validation-engineering/cordis-compat-deepseek/register scripts/demo-rust-modules.mjs",
    "rust:modules:test": "node --test --test-timeout=30000 tests/official/rust-modules.test.mjs tests/official/dynamic-rust-loop.test.mjs",
    "prerust:modules:demo": "node scripts/verify-install.mjs",
    "prerust:modules:test": "node scripts/verify-install.mjs",
    "official:rust": "node scripts/official-native.mjs",
    "official:rust:watch": "node scripts/official-native.mjs --watch",
    "demo:recovery": "node scripts/run-recovery-case.mjs",
    "reproduce:recovery": "node scripts/reproduce-recovery.mjs",
    "test:types": "node --test tests/official/types.test.mjs"
  },
  "dependencies": {
    "@validation-engineering/cordis": "file:.vendor/cordis/validation-engineering-cordis-0.2.0.tgz",
    "@validation-engineering/cordis-compat-deepseek": "file:.vendor/cordis/validation-engineering-cordis-compat-deepseek-0.1.1.tgz",
    "@validation-engineering/cordis-loader": "file:.vendor/cordis/validation-engineering-cordis-loader-0.2.1.tgz",
    "eventsource-parser": "3.1.1",
    "zod": "4.6.5",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-hmr": "0.2.0-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/validation-engineering/harness-verus.git"
  },
  "homepage": "https://github.com/validation-engineering/harness-verus#readme",
  "bugs": {
    "url": "https://github.com/validation-engineering/harness-verus/issues"
  }
}
